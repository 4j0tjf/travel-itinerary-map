# Browser key: restrict with HTTP referrers; allow Maps JavaScript API and Routes API.
VITE_GOOGLE_MAPS_API_KEY=
# Server only. Reserved for future server-side integrations; browser Routes library does not use it.
GOOGLE_MAPS_SERVER_API_KEY=
PORT=6001
# DATA_DIR defaults to ./data (relative to project root).
DATA_DIR=./data
# Optional public URL prefix. Rebuild after changing it; for example /travel.
BASE_PATH=
